#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <150>;
    global-quick-tap;
    flavor = "balanced";
    tapping-term-ms = <240>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 18 17 16 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37 23 24 10 1 4 13 25 21 32 33 34 0 1 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
        };

        smart_shift: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_SHIFT";
            bindings = <&sk RIGHT_SHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        bkspc_del: bkspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BKSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_tap_bspc_del: layer_tap_bspc_del {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BSPC_DEL";
            bindings = <&mo>, <&bkspc_del>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        prev_tab {
            bindings = <&kp LS(LC(TAB))>;
            key-positions = <24 23>;
        };

        next_tab {
            bindings = <&kp LC(TAB)>;
            key-positions = <24 25>;
        };

        homerow_click {
            bindings = <&kp LS(LG(SPACE))>;
            key-positions = <12 13>;
        };

        homerow_scroll {
            bindings = <&kp LS(LG(J))>;
            key-positions = <13 11>;
        };

        capword {
            bindings = <&caps_word>;
            key-positions = <13 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                         &kp Q        &kp W        &kp E                    &kp R          &kp T        &kp Y      &kp U                    &kp I         &kp O        &kp P
                         &hml LGUI A  &hml LALT S  &hml LCTRL D             &hml LSHIFT F  &kp G        &kp H      &hmr RSHFT J             &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMICOLON
&mt LEFT_CONTROL ESCAPE  &kp Z        &kp X        &kp C                    &kp V          &kp B        &kp N      &kp M                    &kp COMMA     &kp DOT      &kp SLASH            &kp APOSTROPHE
                                                   &hml LEFT_COMMAND SPACE  &lt 1 TAB      &kp ENTER    &kp SPACE  &layer_tap_bspc_del 2 0  &smart_shift
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
           &trans        &kp MINUS     &kp EQUAL     &trans        &trans      &kp LC(LS(TAB))  &kp LC(TAB)    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp UP_ARROW
           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5      &kp NUMBER_6     &kp N7         &kp N8            &kp N9             &kp LEFT
&kp GRAVE  &kp LEFT_WIN  &kp MINUS     &trans        &kp PLUS      &kp LPAR    &kp LA(LEFT)     &kp LA(RIGHT)  &kp BACKSLASH     &kp PERIOD         &kp DOWN      &kp RIGHT
                                       &trans        &trans        &trans      &trans           &mo 3          &kp N0
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
           &trans           &kp UNDER    &kp PLUS  &trans      &trans         &trans     &trans         &kp LEFT_BRACE  &kp RIGHT_BRACE        &trans
           &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK    &kp LEFT_PARENTHESIS   &trans
&kp TILDE  &trans           &trans       &trans    &trans      &trans         &kp UNDER  &kp EQUAL      &kp PIPE        &kp RIGHT_PARENTHESIS  &trans  &kp HOME
                                         &trans    &mo 3       &trans         &trans     &trans         &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &bootloader        &trans           &trans       &trans            &to 4     &trans  &trans  &trans       &kp END  &kp F1
        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_MUTE   &kp K_PLAY_PAUSE  &trans    &trans  &trans  &trans       &trans   &kp F10
&trans  &trans             &trans           &trans       &trans            &trans    &trans  &trans  &trans       &trans   &kp F20  &kp F7
                                            &bootloader  &trans            &trans    &trans  &trans  &bootloader
            >;
        };

        Gaming {
            display-name = "Game";
            bindings = <
                  &kp Z           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &sl 5     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
                  &kp TAB         &kp Q         &kp W         &kp E         &kp R     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&mt LCTRL ESCAPE  &kp LEFT_SHIFT  &kp A         &kp S         &kp D         &kp F     &trans  &trans  &trans  &trans  &trans   &to 0
                                                &kp LCTRL     &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;
        };

        Gaming+ {
            display-name = "Game+";
            bindings = <
        &kp F10  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp T     &kp RA(RC(Y))  &kp RA(RC(U))  &trans  &trans  &kp LC(RA(DEL))
        &kp L    &kp O         &kp Y         &kp K         &kp G     &kp F5         &kp F7         &trans  &trans  &kp F12
&trans  &to 0    &trans        &trans        &trans        &trans    &trans         &trans         &trans  &trans  &kp F22          &kp LA(F4)
                               &kp J         &kp I         &kp M     &trans         &trans         &trans
            >;
        };
    };
};
